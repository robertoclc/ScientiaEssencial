<footer class="site-footer">
    <div class="footer-container">
        <!-- Coluna Esquerda: Marca e Tagline -->
        <div class="footer-brand">
            <strong class="brand-title">
                <span class="brand-scientia">Scientia</span>
                <span class="brand-essencial">Essencial</span>
            </strong>

            <div class="slogan-wrapper">
                <p class="slogan-text">
                    <span class="comet-text-target">
                        <span class="text-white">Conhecimento</span>
                        <span class="text-orange">Claro para</span>
                    </span>
                    <span class="text-orange">&nbsp;a Vida Real.</span>
                </p>
                <!-- Canvas dedicado e isolado para renderizar o traço -->
                <canvas id="comet-canvas" class="comet-canvas"></canvas>
            </div>
        </div>

        <!-- Coluna Direita: Redes Sociais -->
        <div class="footer-social">
            <h2>Redes sociais</h2>

            <nav aria-label="Redes sociais">
                <a href="https://www.instagram.com/scientiaessencial/" target="_blank" rel="noopener noreferrer">Instagram</a>
                <a href="https://www.facebook.com/profile.php?id=61587981808351" target="_blank" rel="noopener noreferrer">Facebook</a>
                <a href="https://x.com/ScientiaEssenc" target="_blank" rel="noopener noreferrer">X</a>
                <a href="https://www.youtube.com/@ScientiaEssencial" target="_blank" rel="noopener noreferrer">YouTube</a>
                <a href="https://www.linkedin.com/in/scientia-essencial-412aa53b2/" target="_blank" rel="noopener noreferrer">LinkedIn</a>
            </nav>
        </div>
    </div>

    <div class="footer-bottom">
        <p>© 2026 Scientia Essencial. Todos os direitos reservados.</p>
    </div>
</footer>

<script>
    // Função para desenhar o traço exato via JavaScript
    function drawComet() {
        // Adicionado 'as HTMLElement' para corrigir o erro de tipo no TypeScript
        const target = document.querySelector('.comet-text-target') as HTMLElement;
        const canvas = document.getElementById('comet-canvas') as HTMLCanvasElement;
        
        if (!target || !canvas) return;

        const rect = target.getBoundingClientRect();
        const parentRect = canvas.parentElement?.getBoundingClientRect();

        if (!parentRect) return;

        // Define a largura exata com base na largura real de "Conhecimento Claro para"
        const width = rect.width;
        const height = 12;

        canvas.width = width;
        canvas.height = height;

        // Posição física exata abaixo do texto
        canvas.style.left = `${target.offsetLeft}px`;
        canvas.style.top = `${target.offsetTop + rect.height - 2}px`;

        const ctx = canvas.getContext('2d');
        if (!ctx) return;

        ctx.clearRect(0, 0, width, height);

        // Desenho da forma de cometa (fino na esquerda, largo na direita)
        ctx.beginPath();
        ctx.moveTo(0, 10);
        ctx.quadraticCurveTo(width * 0.5, 11, width - 6, 8);
        ctx.arcTo(width, 6, width - 6, 2, 4);
        ctx.quadraticCurveTo(width * 0.5, 5, 0, 10);
        ctx.closePath();

        // Gradiente laranja
        const gradient = ctx.createLinearGradient(0, 0, width, 0);
        gradient.addColorStop(0, 'rgba(244, 121, 32, 0)');
        gradient.addColorStop(0.2, 'rgba(244, 121, 32, 0.6)');
        gradient.addColorStop(1, '#F47920');

        ctx.fillStyle = gradient;
        ctx.fill();
    }

    // Executa ao carregar e ao redimensionar a tela
    window.addEventListener('load', drawComet);
    window.addEventListener('resize', drawComet);
    document.addEventListener('astro:page-load', drawComet);
    drawComet();
</script>

<style>
    @import url('https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,700;0,800;1,700;1,800&family=Open+Sans:ital,wght@0,400;0,600;1,400&display=swap');

    .site-footer {
        background-color: #0A2540 !important;
        color: #ffffff !important;
        padding-top: 24px;
        font-family: 'Open Sans', sans-serif;
    }

    .footer-container {
