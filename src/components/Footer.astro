        font-family: 'Open Sans', sans-serif;
        font-size: 0.9rem;
    }

    .footer-bottom {
        border-top: 1px solid rgba(255, 255, 255, 0.12);
        padding: 12px 24px;
        text-align: center;
    }

    .footer-bottom p {
        margin: 0;
        color: #ffffff !important;
        font-size: 0.8rem;
        opacity: 0.85;
    }

    @media (max-width: 768px) {
