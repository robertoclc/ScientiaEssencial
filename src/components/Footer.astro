        align-items: center;
        gap: 30px;
    }

    .brand-title {
        display: flex;
        align-items: baseline;
        gap: 6px;
        font-family: 'Montserrat', sans-serif !important;
        font-size: 1.45rem;
        font-weight: 800;
        margin-bottom: 6px;
        letter-spacing: -0.02em;
    }

    .brand-scientia { color: #ffffff !important; }
    .brand-essencial { color: #F47920 !important; }

    .slogan-wrapper {
        position: relative;
        display: inline-block;
    }

    .slogan-text {
        font-family: 'Montserrat', sans-serif !important;
        font-size: 1.15rem !important;
        font-weight: 800 !important;
        font-style: italic !important;
        margin: 0 !important;
        white-space: nowrap;
        display: flex;
        align-items: center;
    }

    .text-white {
        color: #ffffff !important;
        margin-right: 0.25em;
    }

    .text-orange {
        color: #F47920 !important;
    }

    .comet-text-target {
        display: inline-flex;
    }

    /* O Canvas renderiza acima de tudo sem interferência de CSS externo */
    .comet-canvas {
        position: absolute !important;
        pointer-events: none !important;
        z-index: 99 !important;
    }

    .footer-social h2 {
        margin: 0 0 8px;
