---
import Layout from "../layouts/Layout.astro";
import { categorias } from "../data/categorias";
---

<Layout
	title="Categorias | Scientia"
	description="Explore as categorias de conhecimento da Scientia."
>
	<main class="categorias-page">
		<section class="intro">
			<h1>Categorias</h1>

			<p>
				Explore conteúdos organizados por temas e encontre conhecimento
				simples, prático e acessível.
			</p>
		</section>

		<section class="categorias-lista" aria-label="Categorias de conteúdo">
			{categorias.map((categoria) => (
				<a
					href={`/livros?categoria=${categoria.slug}`}
					class="categoria-card"
				>
					<h2>{categoria.title}</h2>

					<p>{categoria.description}</p>

					<span>Ver livros →</span>
				</a>
			))}
		</section>
	</main>
</Layout>

<style>
	.categorias-page {
		max-width: 1200px;
		margin: 0 auto;
		padding: 48px 24px;
	}

	.intro {
		max-width: 800px;
		margin: 0 auto 48px;
		text-align: center;
	}

	.intro h1 {
		margin-bottom: 20px;
		font-size: 2.5rem;
	}

	.intro p {
		margin: 0;
		line-height: 1.7;
		color: #444;
	}

	.categorias-lista {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 28px;
	}

	.categoria-card {
		display: block;
		padding: 28px;
		border: 1px solid #e5e5e5;
		border-radius: 12px;
		background: #ffffff;
		color: inherit;
		text-decoration: none;
		transition: border-color 0.2s ease, transform 0.2s ease;
	}

	.categoria-card:hover {
		border-color: #111;
		transform: translateY(-2px);
	}

	.categoria-card h2 {
		margin: 0 0 14px;
		font-size: 1.4rem;
		color: #111;
	}

	.categoria-card p {
		margin: 0 0 18px;
		line-height: 1.7;
		color: #444;
	}

	.categoria-card span {
		font-weight: 600;
		font-size: 0.9rem;
		color: #111;
	}

	@media (max-width: 700px) {
		.categorias-page {
			padding: 36px 16px;
		}

		.intro h1 {
			font-size: 2rem;
		}

		.categorias-lista {
			grid-template-columns: 1fr;
		}

		.categoria-card {
			padding: 22px;
		}
	}
</style>