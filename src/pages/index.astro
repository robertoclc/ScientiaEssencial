---
import Layout from "../layouts/Layout.astro";
import { livros } from "../data/livros";
import { categorias } from "../data/categorias"; // Caso tenha o arquivo de categorias, se não, pode remover

const logoPath = "/Logo.png"; 

// Pegamos os primeiros 4 livros para exibir na página inicial como destaque
const livrosDestaque = livros.slice(0, 4);

const categoriasExemplo = [
    { title: "Finanças", description: "Investimentos e controle financeiro", slug: "financas" },
    { title: "Tecnologia", description: "Ferramentas digitais e IA", slug: "tecnologia" },
    { title: "Produtividade", description: "Organização e gestão de tempo", slug: "produtividade" },
    { title: "Carreira", description: "Desenvolvimento profissional", slug: "carreira" }
];
---

<Layout
    title="Scientia Essencial | Conhecimento Claro para a Vida Real"
    description="Scientia Essencial: conhecimento claro para a vida real."
>
    <main>
        <!-- Header -->
        <header class="header-main">
            <div class="header-content">
                <a href="/" class="logo-link">
                    <img 
                        src={logoPath} 
                        alt="Scientia Essencial" 
                        class="logo-img" 
                    />
                </a>
            </div>
        </header>

        <!-- Hero -->
        <section class="hero">
            <div class="hero-content">
                <p class="eyebrow">SCIENTIA ESSENCIAL</p>
                <h1>Conhecimento de forma simples, prática e acessível.</h1>
                <p class="hero-text">
                    Conteúdos práticos para quem quer aprender algo novo,
                    desenvolver habilidades e transformar conhecimento em ação.
                </p>
                <a href="/livros" class="btn">Conheça os livros</a>
            </div>
        </section>

        <!-- Sobre -->
        <section class="sobre">
            <div class="section-content">
                <h2>Aprenda sem complicação</h2>
                <p>
                    A Scientia reúne conteúdos desenvolvidos para tornar o
                    conhecimento mais fácil de entender e aplicar no dia a dia.
                </p>
            </div>
        </section>

        <!-- Livros Destaque -->
        <section class="destaque">
            <div class="section-content">
                <p class="eyebrow">SÉRIE PARA LEIGOS</p>
                <h2>Conhecimento para começar do zero</h2>
                <div class="livros-preview">
                    {livrosDestaque.map((livro) => (
                        <article class="livro-card">
                            <div class="card-imagem-container">
                                <img src={livro.imagem} alt={livro.title} class="capa-livro" />
                            </div>
                            <div class="card-info">
                                <h3>{livro.title}</h3>
                                <p>{livro.description}</p>
                                
                                <div class="card-botoes">
                                    <a href={livro.vendasUrl} class="livro-link">Ver Página de Vendas</a>
                                    <a href={livro.checkoutUrl} target="_blank" rel="noopener noreferrer" class="btn-comprar-card">Comprar</a>
                                </div>
                            </div>
                        </article>
                    ))}
                </div>
            </div>
        </section>

        <!-- Categorias -->
        <section class="categorias">
            <div class="section-content">
                <h2>Explore por categoria</h2>
                <div class="categorias-lista">
                    {categoriasExemplo.map((categoria) => (
                        <a href={`/livros?categoria=${categoria.slug}`} class="categoria">
                            <strong>{categoria.title}</strong>
                            <span>{categoria.description}</span>
                        </a>
                    ))}
                </div>
            </div>
        </section>
    </main>
</Layout>

<style>
    :root {
        --azul-marinho: #0A2540;
        --azul-medio: #19344c;
        --azul-claro: #4B9CD3;
        --laranja: #f47920;
        --fundo-suave: #f7f9fc;
    }

    /* Header */
    .header-main {
        background: #ffffff;
        padding: 16px 24px;
        border-bottom: 3px solid var(--laranja);
    }
    .header-content {
        max-width: 1200px;
        margin: 0 auto;
    }
    .logo-img {
        height: 55px;
        width: auto;
        display: block;
    }

    /* Hero */
    .hero {
        padding: 70px 24px;
        background: var(--fundo-suave);
        text-align: center;
    }
    .hero-content, .section-content {
        max-width: 1200px;
        margin: 0 auto;
    }
    .hero-content { max-width: 800px; }
    .eyebrow {
        margin: 0 0 12px;
        font-family: sans-serif;
        font-size: 0.85rem;
        font-weight: 700;
        letter-spacing: 0.15em;
        color: var(--laranja);
    }
    h1 {
        margin: 0;
        font-family: sans-serif;
        font-size: 2.5rem;
        color: var(--azul-marinho);
    }
    .hero-text {
        margin: 20px auto 26px;
        font-size: 1.1rem;
        color: var(--azul-medio);
    }
    .btn {
        display: inline-block;
        padding: 12px 24px;
        border-radius: 6px;
        background: var(--laranja);
        color: #ffffff;
        text-decoration: none;
        font-weight: 700;
    }

    /* Seções */
    .sobre, .destaque, .categorias { padding: 60px 24px; }
    .sobre { text-align: center; }
    .destaque { background: var(--fundo-suave); }

    .livros-preview {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 20px;
        margin-top: 30px;
    }
    .livro-card {
        padding: 20px;
        background: #ffffff;
        border-left: 4px solid var(--azul-claro);
        border-radius: 6px;
        display: flex;
        gap: 20px;
        align-items: center;
    }
    .card-imagem-container {
        flex-shrink: 0;
        width: 120px;
    }
    .capa-livro {
        width: 100%;
        height: auto;
        border-radius: 4px;
        box-shadow: 0 4px 8px rgba(0,0,0,0.1);
        display: block;
    }
    .card-info {
        display: flex;
        flex-direction: column;
        flex-grow: 1;
    }
    .card-botoes {
        display: flex;
        gap: 12px;
        align-items: center;
        margin-top: 15px;
    }
    .livro-link {
        color: var(--laranja);
        font-weight: 700;
        text-decoration: none;
        font-size: 0.9rem;
    }
    .btn-comprar-card {
        padding: 8px 16px;
        background: var(--laranja);
        color: #ffffff;
        border-radius: 4px;
        font-weight: 700;
        text-decoration: none;
        font-size: 0.9rem;
    }
    .btn-comprar-card:hover, .livro-link:hover {
        opacity: 0.9;
    }

    .categorias-lista {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 16px;
        margin-top: 20px;
    }
    .categoria {
        padding: 16px;
        border: 1px solid var(--laranja);
        border-radius: 6px;
        text-decoration: none;
        color: var(--azul-marinho);
    }
    .categoria strong { display: block; }
    .categoria span { font-size: 0.85rem; color: var(--azul-medio); }

    @media (max-width: 768px) {
        .livros-preview, .categorias-lista { grid-template-columns: 1fr; }
        .livro-card { flex-direction: column; align-items: flex-start; }
        .card-imagem-container { width: 100px; margin: 0 auto; }
    }
</style>